.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.DS_Store
results/*.csv
results/*.json
results/*.png
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Same rules at any depth. The patterns above are anchored to the repo root by
# their slash, so a stray notebooks/data/raw/ slipped past them once.
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Python packaging metadata
*.egg-info/
